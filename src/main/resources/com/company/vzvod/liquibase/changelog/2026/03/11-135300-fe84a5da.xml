<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="Tarasov Aleksey">
        <dropForeignKeyConstraint baseTableName="user_" constraintName="fk_user__on_contacts_info"/>
    </changeSet>
    <changeSet id="2" author="Tarasov Aleksey">
        <dropForeignKeyConstraint baseTableName="ADMINISTRATIVE_VIOLATION"
                                  constraintName="FK_ADMINISTRATIVE_VIOLATION_ON_SHIFT"/>
    </changeSet>
    <changeSet id="3" author="Tarasov Aleksey">
        <dropForeignKeyConstraint baseTableName="CRIMINAL_VIOLATION" constraintName="FK_CRIMINAL_VIOLATION_ON_SHIFT"/>
    </changeSet>
    <changeSet id="4" author="Tarasov Aleksey">
        <dropForeignKeyConstraint baseTableName="SERVICE_INFO" constraintName="FK_SERVICE_INFO_ON_ID_CARD"/>
    </changeSet>
    <changeSet id="5" author="Tarasov Aleksey">
        <dropForeignKeyConstraint baseTableName="SERVICE_INFO" constraintName="FK_SERVICE_INFO_ON_USER"/>
    </changeSet>
    <changeSet id="6" author="Tarasov Aleksey">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists
                    foreignKeyName="fk_shift_service_info_on_service_info"
                    foreignKeyTableName="shift_service_info"/>
        </preConditions>

        <dropForeignKeyConstraint
                baseTableName="shift_service_info"
                constraintName="fk_shift_service_info_on_service_info"/>
    </changeSet>
    <changeSet id="7" author="Tarasov Aleksey">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists
                    foreignKeyName="fk_shift_service_info_on_shift"
                    foreignKeyTableName="shift_service_info"/>
        </preConditions>

        <dropForeignKeyConstraint
                baseTableName="shift_service_info"
                constraintName="fk_shift_service_info_on_shift"/>
    </changeSet>
    <changeSet id="8" author="Tarasov Aleksey">
        <addColumn tableName="CONTACTS">
            <column name="USER_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="8a" author="Tarasov Aleksey">
        <sql>
            UPDATE CONTACTS c
            SET USER_ID = (
                SELECT u.ID
                FROM USER_ u
                WHERE u.CONTACTS_INFO_ID = c.ID
            )
            WHERE c.USER_ID IS NULL
        </sql>
    </changeSet>
    <changeSet id="8d" author="Tarasov Aleksey">
        <dropIndex tableName="USER_" indexName="IDX_USER__CONTACTS_INFO"/>
    </changeSet>
    <changeSet id="8e" author="Tarasov Aleksey">
        <dropColumn tableName="USER_" columnName="CONTACTS_INFO_ID"/>
    </changeSet>
    <changeSet id="8b" author="Tarasov Aleksey">
        <addNotNullConstraint tableName="CONTACTS" columnName="USER_ID"/>
    </changeSet>
    <changeSet id="8c" author="Tarasov Aleksey">
        <addUniqueConstraint tableName="CONTACTS"
                             columnNames="USER_ID"
                             constraintName="UK_CONTACTS_USER_ID"/>
    </changeSet>
    <changeSet id="9" author="Tarasov Aleksey">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="SHIFT_SERVICE_INFO" indexName="pk_shift_service_info"/>
        </preConditions>

        <dropIndex tableName="SHIFT_SERVICE_INFO" indexName="pk_shift_service_info"/>
    </changeSet>

    <changeSet id="9a" author="Tarasov Aleksey">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="SHIFT_SERVICE_INFO"/>
            </not>
        </preConditions>

        <addPrimaryKey tableName="SHIFT_SERVICE_INFO"
                       columnNames="SERVICE_INFO_ID, SHIFT_ID"
                       constraintName="PK_SHIFT_SERVICE_INFO"/>
    </changeSet>
    <changeSet id="10" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="CONTACTS" constraintName="FK_CONTACTS_ON_USER"
                                 referencedColumnNames="ID" referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="11" author="Tarasov Aleksey">
        <dropIndex indexName="idx_administrative_violation_shift" tableName="administrative_violation"/>
    </changeSet>
    <changeSet id="12" author="Tarasov Aleksey">
        <dropIndex indexName="idx_criminal_violation_shift" tableName="criminal_violation"/>
    </changeSet>
    <changeSet id="13" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="SHIFT_ID" baseTableName="ADMINISTRATIVE_VIOLATION"
                                 constraintName="FK_ADMINISTRATIVE_VIOLATION_ON_SHIFT" referencedColumnNames="ID"
                                 referencedTableName="SHIFT"/>
    </changeSet>
    <changeSet id="14" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="SHIFT_ID" baseTableName="CRIMINAL_VIOLATION"
                                 constraintName="FK_CRIMINAL_VIOLATION_ON_SHIFT" referencedColumnNames="ID"
                                 referencedTableName="SHIFT"/>
    </changeSet>
    <changeSet id="15" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="ID_CARD_ID" baseTableName="SERVICE_INFO"
                                 constraintName="FK_SERVICE_INFO_ON_ID_CARD" referencedColumnNames="ID"
                                 referencedTableName="ID_CARD"/>
    </changeSet>
    <changeSet id="16" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="SERVICE_INFO"
                                 constraintName="FK_SERVICE_INFO_ON_USER" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="17" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="SERVICE_INFO_ID" baseTableName="SHIFT_SERVICE_INFO"
                                 constraintName="FK_SHISERINF_ON_SERVICE_INFO" referencedColumnNames="ID"
                                 referencedTableName="SERVICE_INFO"/>
    </changeSet>
    <changeSet id="18" author="Tarasov Aleksey">
        <addForeignKeyConstraint baseColumnNames="SHIFT_ID" baseTableName="SHIFT_SERVICE_INFO"
                                 constraintName="FK_SHISERINF_ON_SHIFT" referencedColumnNames="ID"
                                 referencedTableName="SHIFT"/>
    </changeSet>
    <changeSet id="19" author="Tarasov Aleksey">
        <dropColumn columnName="ALL_REMAIND_DAYS" tableName="VOCATION"/>
    </changeSet>
    <changeSet id="20" author="Tarasov Aleksey">
        <addColumn tableName="VOCATION">
            <column name="ALL_REMAIND_DAYS" type="INT"/>
        </addColumn>
    </changeSet>
    <changeSet id="21" author="Tarasov Aleksey">
        <dropColumn columnName="ARTICLE" tableName="ADMINISTRATIVE_VIOLATION"/>
    </changeSet>
    <changeSet id="22" author="Tarasov Aleksey">
        <addColumn tableName="ADMINISTRATIVE_VIOLATION">
            <column name="ARTICLE" type="INT"/>
        </addColumn>
    </changeSet>
    <changeSet id="23" author="Tarasov Aleksey">
        <modifyDataType columnName="CITY_TO_DRIVE" newDataType="VARCHAR(255)" tableName="VOCATION"/>
    </changeSet>
    <changeSet id="24" author="Tarasov Aleksey">
        <dropColumn columnName="NUMBER" tableName="SHIFT"/>
    </changeSet>
    <changeSet id="25" author="Tarasov Aleksey">
        <addColumn tableName="SHIFT">
            <column name="NUMBER" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>