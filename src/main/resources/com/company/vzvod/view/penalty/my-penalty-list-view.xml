<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="Мои взыскания"
      focusComponent="penaltiesDataGrid">
    <data>
        <collection id="penaltiesDc"
                    class="com.company.vzvod.entity.Penalty">
            <fetchPlan extends="_base">
                <property name="userServiceInfo">
                    <property name="user">
                        <property name="firstName"/>
                        <property name="lastName"/>
                        <property name="patronymic"/>
                    </property>
                    <property name="department" fetchPlan="_base"/>
                    <property name="rank"/>
                    <property name="post"/>
                </property>
            </fetchPlan>
            <loader id="penaltiesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Penalty e where :serviceInfo is null or e.userServiceInfo = :serviceInfo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <dataGrid id="penaltiesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="penaltiesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="initiator"/>
                <column property="penaltyType"/>
                <column property="penaltyStatus"/>
                <column property="date"/>
                <column property="orderNumber"/>
                <column property="description"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="penaltiesDataGrid.createAction" text="msg://createButton.text"/>
                <button id="editButton" action="penaltiesDataGrid.editAction"/>
                <button id="removeButton" action="penaltiesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="penaltiesDl"/>
            </endSlot>
        </hbox>
    </layout>
</view>

