<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://userListView.title">

    <data>
        <!-- без отдела -->
        <collection id="usersNoDeptDc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base">
                <property name="serviceInfo">
                    <property name="rank"/>
                    <property name="post"/>
                </property>
            </fetchPlan>
            <loader id="usersNoDeptDl">

                <query>
                    <![CDATA[
                        select u
                        from User u
                        left join u.serviceInfo si
                        left join si.department d
                        where d is null
                        order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- отдел 1 -->
        <collection id="dept1UsersDc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base">
                <property name="serviceInfo">
                    <property name="rank"/>
                </property>
            </fetchPlan>
            <loader id="dept1UsersDl">
                <query>
                    <![CDATA[
                        select u
                        from User u
                        join u.serviceInfo si
                        join si.department d
                        where d.number = 1
                        order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- отдел 2 -->
        <collection id="dept2UsersDc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base">
                <property name="serviceInfo">
                    <property name="rank"/>
                </property>
            </fetchPlan>
            <loader id="dept2UsersDl">
                <query>
                    <![CDATA[
                        select u
                        from User u
                        join u.serviceInfo si
                        join si.department d
                        where d.number = 2
                        order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
                    ]]>
                </query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout padding="true" spacing="true" width="100%" classNames="user-list-small">

        <!--        <h2 text="Список сотрудников"/>-->

        <vbox>
            <details summaryText="msg://com.company.vzvod.view.userlist/userListView.commanders.summaryText" opened="true" width="50%" alignSelf="CENTER">
                <dataGrid id="noDeptDataGrid"
                          dataContainer="usersNoDeptDc"
                          width="100%" height="150px">
                    <columns>
                        <column property="serviceInfo.rank"/>
                        <column property="lastName"/>
                        <column property="firstName"/>
                        <column property="patronymic"/>
                    </columns>
                </dataGrid>
            </details>

            <!-- Две колонки: отдел 1 и отдел 2 -->
            <hbox width="100%" spacing="true">
                <vbox width="50%">
                    <h3 text="msg://com.company.vzvod.view.userlist/userListView.department1.title" alignSelf="CENTER"/>
                    <dataGrid id="dept1DataGrid"
                              dataContainer="dept1UsersDc"
                              width="100%"
                              minHeight="10em">
                        <columns>
                            <column property="serviceInfo.rank"/>
                            <column property="lastName"/>
                            <column property="firstName"/>
                            <column property="patronymic"/>
                        </columns>
                    </dataGrid>
                </vbox>

                <vbox width="50%">
                    <h3 text="msg://com.company.vzvod.view.userlist/userListView.department2.title" alignSelf="CENTER"/>
                    <dataGrid id="dept2DataGrid"
                              dataContainer="dept2UsersDc"
                              width="100%"
                              minHeight="10em">
                        <columns>
                            <column property="serviceInfo.rank"/>
                            <column property="lastName"/>
                            <column property="firstName"/>
                            <column property="patronymic"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </hbox>
        </vbox>
    </layout>
</view>