<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://vocationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="vocationDc"
                  class="com.company.vzvod.entity.Vocation">
            <fetchPlan extends="_base">
                <property name="userServiceInfo">
                    <property name="user">
                        <property name="firstName"/>
                        <property name="lastName"/>
                        <property name="patronymic"/>
                    </property>
                    <property name="department" fetchPlan="_base"/>
                    <property name="post"/>
                </property>
            </fetchPlan>
            <loader id="vocationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="vocationDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="userServiceInfoField" property="userServiceInfo">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <select id="typeField" property="type"/>
            <datePicker id="startDateField" property="startDate"/>
            <datePicker id="endDateField" property="endDate"/>
            <integerField id="vacationDaysUsedField"
                          readOnly="true"
                          label="msg://com.company.vzvod.view.vocation/vocationDetailView.vacationDaysUsedField.label"/>
            <integerField id="vacationDaysAvailableField"
                          readOnly="true"
                          label="msg://com.company.vzvod.view.vocation/vocationDetailView.vacationDaysAvailableField.label"/>
            <textField id="cityToDriveField" property="cityToDrive"/>
            <textField id="daysAddedByDepartureField" property="daysAddedByDeparture"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
