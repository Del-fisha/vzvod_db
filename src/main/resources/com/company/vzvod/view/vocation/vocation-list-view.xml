<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://vocationListView.title"
      focusComponent="vocationsDataGrid">
    <data>
        <collection id="vocationsDc"
                    class="com.company.vzvod.entity.Vocation">
            <fetchPlan extends="_base">
                <property name="userServiceInfo">
                    <property name="user">
                        <property name="firstName"/>
                        <property name="lastName"/>
                        <property name="patronymic"/>
                    </property>
                    <property name="post"/>
                </property>
            </fetchPlan>
            <loader id="vocationsDl" readOnly="true">
                <query>
                    <![CDATA[
        select e from Vocation e
        where :serviceInfo is null
           or e.userServiceInfo = :serviceInfo
    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="vocationsDataGrid.createAction"/>
                <button id="editButton" action="vocationsDataGrid.editAction"/>
                <button id="removeButton" action="vocationsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="vocationsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="vocationsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="vocationsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="userServiceInfo" width="1%"/>
                <column property="type" width="1%"/>
                <column property="startDate"/>
                <column property="endDate"/>
<!--                <column property="countOfDays"/>-->
<!--                <column property="allRemaindDays"/>-->
                <column property="cityToDrive"/>
                <column property="daysAddedByDeparture"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
