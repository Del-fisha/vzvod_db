<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Смена пароля">
    <layout>
        <formLayout id="form">
            <passwordField id="oldPasswordField" label="Старый пароль" required="true"/>
            <passwordField id="newPasswordField" label="Новый пароль" required="true"/>
            <passwordField id="confirmPasswordField" label="Повтор нового пароля" required="true"/>
        </formLayout>

        <hbox>
            <button id="saveButton" text="Сохранить"/>
            <button id="cancelButton" text="Отмена"/>
        </hbox>
    </layout>
</view>
