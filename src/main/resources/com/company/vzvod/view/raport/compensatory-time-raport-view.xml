<view xmlns="http://jmix.io/schema/flowui/view">

    <data>
        <collection id="employeesDept1Dc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base"/>
            <loader id="employeesDept1Dl">
                <query>
                    <![CDATA[
                        select u
                        from User u
                        join u.serviceInfo si
                        where si.post not in ('A', 'B')
                          and si.department.number = 1
                        order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
                    ]]>
                </query>
            </loader>
        </collection>

        <collection id="employeesDept2Dc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base"/>
            <loader id="employeesDept2Dl">
                <query>
                    <![CDATA[
                        select u
                        from User u
                        join u.serviceInfo si
                        where si.post not in ('A', 'B')
                          and si.department.number = 2
                        order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
                    ]]>
                </query>
            </loader>
        </collection>

        <collection id="commandersDc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan extends="_base"/>
            <loader id="commandersDl">
                <query>
                    <![CDATA[
                select u from User u
                where u.serviceInfo.post not in ('D', 'E')
                order by u.serviceInfo.post, u.serviceInfo.rank desc, u.lastName
            ]]>
                </query>
            </loader>
        </collection>

    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout spacing="true" padding="true" width="500px" height="600px">

        <hbox width="100%">
            <entityComboBox id="employeeDept1Picker"
                            metaClass="User"
                            label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.employeeDept1Picker.label"
                            itemsContainer="employeesDept1Dc"
                            width="100%"/>

            <entityComboBox id="employeeDept2Picker"
                            metaClass="User"
                            label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.employeeDept2Picker.label"
                            itemsContainer="employeesDept2Dc"
                            width="100%"/>
        </hbox>

        <entityComboBox id="intercederUserPicker"
                        metaClass="User"
                        label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.intercederUserPicker.label"
                        itemsContainer="commandersDc"
                        width="100%"/>

        <comboBox id="recipientComboBox"
                  label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.recipientComboBox.label"
                  width="100%"/>

        <hbox width="100%">
            <datePicker id="reportDateField"
                        label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.reportDateField.label"
                        datatype="localDate"/>

            <datePicker id="dayOffDateField"
                        label="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.dayOffDateField.label"
                        datatype="localDate"/>
        </hbox>

        <hbox width="100%" spacing="true">
            <button id="sendBtn"
                    text="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.sendBtn.text"
                    themeNames="primary"/>

            <button id="sendAndPrintBtn"
                    text="msg://com.company.vzvod.view.raport/compensatoryTimeRaportView.sendAndPrintBtn.text"
                    themeNames="primary contrast"/>
        </hbox>
    </layout>
</view>