<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://com.company.vzvod.userCardView.title"
      focusComponent="mainAccordion">

    <data>
        <!-- Основной пользователь -->
        <instance id="userDc"
                  class="com.company.vzvod.entity.User">
            <fetchPlan>
                <!-- основные поля -->
                <property name="firstName"/>
                <property name="lastName"/>
                <property name="patronymic"/>
                <property name="dateOfBirth"/>

                <!-- служебная инфа -->
                <property name="serviceInfo">
                    <property name="department" fetchPlan="_base"/>
                    <property name="rank"/>
                    <property name="qualificationClass"/>
                    <property name="status"/>
                    <property name="post"/>
                    <property name="token"/>
                    <property name="breastplate"/>
                    <property name="startDate"/>
                    <property name="startOfPost"/>
                    <property name="vacationDaysAvailable"/>
                    <property name="vacationDaysEntitled"/>
                    <property name="idCard">
                        <property name="spl"/>
                        <property name="issued"/>
                        <property name="until"/>
                    </property>
                </property>

                <!-- контакты + вложенные адреса -->
                <property name="contactsInfo">
                    <property name="phoneNumber"/>
                    <property name="nearestMetroStation"/>
                    <property name="registration" fetchPlan="_base"/>
                    <property name="habitation" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="userDl"/>
        </instance>

        <!-- Вложенные контейнеры для удобной привязки форм -->
        <instance id="serviceInfoDc"
                  class="com.company.vzvod.entity.ServiceInfo"/>
        <instance id="contactsDc"
                  class="com.company.vzvod.entity.Contacts"/>
        <instance id="regAddressDc"
                  class="com.company.vzvod.entity.Address"/>
        <instance id="habAddressDc"
                  class="com.company.vzvod.entity.Address"/>

        <!-- Служебное удостоверение -->
        <instance id="idCardDc"
                  class="com.company.vzvod.entity.IdCard"/>

        <!-- Смены сотрудника -->
        <collection id="shiftsDc"
                    class="com.company.vzvod.entity.Shift">
            <fetchPlan extends="_base"/>
            <loader id="shiftsDl" readOnly="true">
                <query>
                    <![CDATA[
                        select distinct s
                        from Shift s
                        join s.units si
                        where si.user = :user
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Сотрудники того же отделения для быстрой навигации -->
        <collection id="colleaguesDc"
                    class="com.company.vzvod.entity.User">
            <fetchPlan>
                <property name="lastName"/>
                <property name="firstName"/>
                <property name="patronymic"/>
                <property name="serviceInfo">
                    <property name="department"/>
                </property>
            </fetchPlan>
            <loader id="colleaguesDl">
                <query>
                    <![CDATA[
                        select u
                        from User u
                        join u.serviceInfo si
                        where
                            (:department is null and si.department is null)
                            or si.department = :department
                        order by u.lastName, u.firstName
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Поощрения выбранного сотрудника -->
        <collection id="incentivesDc"
                    class="com.company.vzvod.entity.Incentive">
            <fetchPlan extends="_base"/>
            <loader id="incentivesDl" readOnly="true">
                <query>
                    <![CDATA[
                        select i
                        from Incentive i
                        where i.userServiceInfo = :serviceInfo
                        order by i.date desc, i.id desc
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Взыскания выбранного сотрудника -->
        <collection id="penaltiesDc"
                    class="com.company.vzvod.entity.Penalty">
            <fetchPlan extends="_base"/>
            <loader id="penaltiesDl" readOnly="true">
                <query>
                    <![CDATA[
                        select p
                        from Penalty p
                        where p.userServiceInfo = :serviceInfo
                        order by p.date desc, p.id desc
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Транспорт выбранного сотрудника -->
        <collection id="vehiclesDc"
                    class="com.company.vzvod.entity.Vehicle">
            <fetchPlan extends="_base"/>
            <loader id="vehiclesDl" readOnly="true">
                <query>
                    <![CDATA[
                        select v
                        from Vehicle v
                        where v.user = :user
                        order by v.stateNumber
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Таблица результатов работы выбранного сотрудника (рассчитывается в контроллере) -->
        <keyValueCollection id="workResultsDc">
            <properties>
                <property name="category" datatype="string"/>
                <property name="month" datatype="int"/>
                <property name="year" datatype="int"/>
                <property name="total" datatype="int"/>
            </properties>
        </keyValueCollection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout padding="true" spacing="true" width="100%" classNames="user-card-view">

        <!-- Верхняя панель: Назад + заголовок -->
        <hbox id="topBar" width="100%" spacing="true">
            <button id="backButton" text="Назад"/>
            <div width="100%"/>
            <h2 id="header"/>
            <div width="100%"/>
        </hbox>

        <!-- Общий layout: слева список отделения, справа карточка -->
        <hbox width="100%" spacing="true" alignItems="START">
            <!-- Левая колонка: сотрудники отделения -->
            <vbox width="25%" spacing="true" flexShrink="0">
                <h3 text="msg://com.company.vzvod.view.usercard/userCardView.colleaguesSection.title"/>
                <dataGrid id="colleaguesDataGrid"
                          dataContainer="colleaguesDc"
                          width="100%"
                          minHeight="20em">
                    <columns>
                        <column key="shortFio" header="Фамилия И. О."/>
                    </columns>
                </dataGrid>
            </vbox>

            <!-- Правая часть: сама карточка пользователя -->
            <vbox width="75%" spacing="true" flexGrow="1" flexShrink="1">

                <!-- Верх: слева User + ServiceInfo, справа аккордеон с контактами и адресами -->
                <hbox id="userCardHeaderRow" width="100%" spacing="true" alignItems="START">
                    <!-- Левая колонка (данные пользователя и ServiceInfo) -->
                    <vbox width="50%" spacing="true" flexGrow="0">
                        <!-- Основные поля пользователя -->
                        <formLayout id="userForm"
                                    dataContainer="userDc"
                                    labelsPosition="ASIDE">
                            <!-- Можно вернуть ФИО, если надо -->
                            <!--
                            <textField property="lastName" readOnly="true"/>
                            <textField property="firstName" readOnly="true"/>
                            <textField property="patronymic" readOnly="true"/>
                            -->
                            <formItem>
                                <textField property="dateOfBirth" readOnly="true"/>
                            </formItem>
                        </formLayout>

                        <!-- Служебная информация (без аккордеона) -->
                        <formLayout id="serviceInfoForm"
                                    dataContainer="serviceInfoDc"
                                    labelsPosition="ASIDE">
                            <formItem>
                                <textField property="department" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="rank" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="qualificationClass" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="post" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="status" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="token" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="breastplate" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="startDate" readOnly="true"/>
                            </formItem>
                            <formItem>
                                <textField property="startOfPost" readOnly="true"/>
                            </formItem>
                        </formLayout>
                    </vbox>

                    <!-- Правая колонка (контакты и адреса) -->
                    <vbox width="50%" flexGrow="0" spacing="false" padding="false">
                        <accordion id="mainAccordion" width="100%">
                            <!-- Контакты -->
                            <accordionPanel summaryText="msg://com.company.vzvod.view.usercard/userCardView.contactsPanel.summaryText">
                                <formLayout dataContainer="contactsDc"
                                            labelsPosition="ASIDE"
                                            autoResponsive="false">
                                    <formItem>
                                        <textField property="phoneNumber" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="nearestMetroStation" readOnly="true"/>
                                    </formItem>
                                </formLayout>
                            </accordionPanel>

                            <!-- Адрес регистрации -->
                            <accordionPanel summaryText="msg://com.company.vzvod.view.usercard/userCardView.registrationAddressPanel.summaryText">
                                <formLayout dataContainer="regAddressDc"
                                            labelsPosition="ASIDE">
                                    <formItem>
                                        <textField property="index" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="city" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="street" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="houseNumber" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="body" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="flat" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="typeOfHousing" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="statusOfHousing" readOnly="true"/>
                                    </formItem>
                                </formLayout>
                            </accordionPanel>

                            <!-- Адрес проживания -->
                            <accordionPanel summaryText="msg://com.company.vzvod.view.usercard/userCardView.habitationAddressPanel.summaryText">
                                <formLayout dataContainer="habAddressDc"
                                            labelsPosition="ASIDE">
                                    <formItem>
                                        <textField property="index" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="city" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="street" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="houseNumber" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="body" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="flat" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="typeOfHousing" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <textField property="statusOfHousing" readOnly="true"/>
                                    </formItem>
                                </formLayout>
                            </accordionPanel>

                            <accordionPanel summaryText="msg://com.company.vzvod.view.usercard/userCardView.vacationsPanel.summaryText">
                                <formLayout dataContainer="serviceInfoDc" labelsPosition="ASIDE">
                                    <formItem>
                                        <integerField id="vacationDaysEntitledField"
                                                      property="vacationDaysEntitled"
                                                      readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <integerField id="vacationDaysUsedField"
                                                      property="vacationDaysUsed"
                                                      readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <integerField id="vacationDaysAvailableField"
                                                      property="vacationDaysAvailable"
                                                      readOnly="true"/>
                                    </formItem>
                                </formLayout>
                            </accordionPanel>

                            <accordionPanel summaryText="Поощрения сотрудника">
                                <dataGrid id="incentivesDataGrid"
                                          dataContainer="incentivesDc"
                                          width="100%"
                                          columnReorderingAllowed="false">
                                    <columns>
                                        <column property="date"/>
                                        <column property="incentiveType"/>
                                        <column property="initiator"/>
                                        <column property="orderNumber"/>
                                        <column property="description"/>
                                    </columns>
                                </dataGrid>
                            </accordionPanel>

                            <accordionPanel summaryText="Взыскания сотрудника">
                                <dataGrid id="penaltiesDataGrid"
                                          dataContainer="penaltiesDc"
                                          width="100%"
                                          columnReorderingAllowed="false">
                                    <columns>
                                        <column property="date"/>
                                        <column property="penaltyType"/>
                                        <column property="penaltyStatus"/>
                                        <column property="initiator"/>
                                        <column property="orderNumber"/>
                                        <column property="description"/>
                                    </columns>
                                </dataGrid>
                            </accordionPanel>

                            <accordionPanel summaryText="Транспорт сотрудника">
                                <dataGrid id="vehiclesDataGrid"
                                          dataContainer="vehiclesDc"
                                          width="100%"
                                          columnReorderingAllowed="false">
                                    <columns>
                                        <column property="stateNumber"/>
                                        <column property="brand"/>
                                        <column property="model"/>
                                        <column property="registrationCertificate"/>
                                        <column property="insurance"/>
                                    </columns>
                                </dataGrid>
                            </accordionPanel>

                            <accordionPanel summaryText="Служебное удостоверение">
                                <formLayout dataContainer="idCardDc" labelsPosition="ASIDE">
                                    <formItem>
                                        <textField property="spl" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <datePicker property="issued" readOnly="true"/>
                                    </formItem>
                                    <formItem>
                                        <datePicker property="until" readOnly="true"/>
                                    </formItem>
                                </formLayout>
                            </accordionPanel>

                            <accordionPanel summaryText="Результаты работы сотрудника">
                                <dataGrid id="workResultsDataGrid"
                                          dataContainer="workResultsDc"
                                          width="100%"
                                          columnReorderingAllowed="false">
                                    <columns>
                                        <column property="category" header="Показатель"/>
                                        <column property="month" header="За месяц"/>
                                        <column property="year" header="За год"/>
                                        <column property="total" header="Всего"/>
                                    </columns>
                                </dataGrid>
                            </accordionPanel>
                        </accordion>
                    </vbox>
                </hbox>

                <!-- Низ: общий аккордеон "Смены" -->
                <accordion id="shiftsAccordion" width="100%">
                    <accordionPanel summaryText="msg://com.company.vzvod.view.usercard/userCardView.shiftsPanel.summaryText">
                        <dataGrid id="shiftsDataGrid"
                                  dataContainer="shiftsDc"
                                  width="100%"
                                  columnReorderingAllowed="false">
                            <columns>
                                <column property="date"/>
                                <column property="number"/>
                                <column property="typeOfShift"/>
                                <column property="startTime"/>
                                <column property="endTime"/>
                            </columns>
                        </dataGrid>
                    </accordionPanel>
                </accordion>
            </vbox>
        </hbox>

    </layout>
</view>