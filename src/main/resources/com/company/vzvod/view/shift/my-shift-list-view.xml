<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://myShiftListView.title"
      focusComponent="shiftsDataGrid">
    <data>
        <collection id="shiftsDc"
                    class="com.company.vzvod.entity.Shift">
            <fetchPlan extends="_base">
                <property name="units" fetchPlan="_base"/>
                <property name="criminalViolations" fetchPlan="_base"/>
                <property name="administrativeViolations" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="shiftsDl" readOnly="true">
                <query>
                    <![CDATA[
            select distinct e
            from Shift e
            join e.units u
            join u.user usr
            where usr.username = :current_user_username
        ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="shiftsDataGrid.createAction"/>
                <button id="editButton" action="shiftsDataGrid.editAction"/>
                <button id="readButton" action="shiftsDataGrid.readAction"/>
                <button id="removeButton" action="shiftsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="shiftsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="shiftsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="shiftsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="readAction" type="list_read"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="number"/>
                <column property="typeOfShift"/>
                <column property="departmentToday"/>
                <column property="date"/>
                <column property="startTime"/>
                <column property="endTime"/>
                <column property="countOfStatements"/>
                <column property="countOfClaims"/>
                <column property="ibdWithMigrant"/>
                <column property="ibdWithoutMigrant"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
