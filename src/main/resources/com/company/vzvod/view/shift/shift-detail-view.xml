<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://shiftDetailView.title"
      focusComponent="form">
    <data>
        <instance id="shiftDc"
                  class="com.company.vzvod.entity.Shift">
            <fetchPlan extends="_base">
                <property name="units">
                    <property name="user">
                        <property name="firstName"/>
                        <property name="lastName"/>
                        <property name="patronymic"/>
                    </property>
                    <property name="department" fetchPlan="_base"/>
                </property>

                <!-- подтягиваем административные нарушения -->
                <property name="administrativeViolations" fetchPlan="_base"/>

                <!-- подтягиваем уголовные нарушения -->
                <property name="criminalViolations" fetchPlan="_base"/>
            </fetchPlan>

            <loader id="shiftDl"/>

            <!-- Сотрудники -->
            <collection id="unitsDc" property="units"/>

            <!-- Административные -->
            <collection id="administrativeViolationsDc"
                        property="administrativeViolations"/>

            <!-- Уголовные -->
            <collection id="criminalViolationsDc"
                        property="criminalViolations"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <hbox id="mainColumns"
                  spacing="true"
                  width="100%"
                  height="100%"
                  expand="left">
                <!-- ЛЕВАЯ КОЛОНКА - ТАБЛИЦА С СОТРУДНИКАМИ -->
                <vbox id="left" spacing="true" height="100%">
                    <!-- БЛОК 1. Сотрудники -->
                    <h3 text="Сотрудники в наряде"/>
                    <hbox spacing="true">
                        <button id="addUnitBtn" action="unitsDataGrid.add" text="Добавить сотрудника" themeNames="primary"/>
                        <button id="removeUnitBtn" action="unitsDataGrid.remove" text="Удалить"/>
                    </hbox>
                    <dataGrid id="unitsDataGrid"
                              dataContainer="unitsDc"
                              width="100%"
                              minHeight="8em">
                        <columns>
                            <column property="user.lastName" header="Фамилия"/>
                            <column property="user.firstName" header="Имя"/>
                            <column property="user.patronymic" header="Отчество"/>
                        </columns>
                        <actions>
                            <!-- создаёт связь с уже существующим ServiceInfo -->
                            <action id="add" type="list_add"/>
                            <action id="remove" type="list_remove"/>
                        </actions>
                    </dataGrid>

                    <!-- БЛОК 2. Административные нарушения -->
                    <h3 text="Административная практика"/>
                    <hbox spacing="true">
                        <button id="addAdminBtn" action="adminViolationsDataGrid.create" text="Добавить/Редактировать АП" themeNames="primary"/>
                        <button id="removeAdminBtn" action="adminViolationsDataGrid.remove" text="Удалить"/>
                    </hbox>
                    <dataGrid id="adminViolationsDataGrid"
                              dataContainer="administrativeViolationsDc"
                              width="100%"
                              minHeight="8em">
                        <columns>
                            <!-- подберите подходящие свойства вашей сущности AdministrativeViolation -->
                            <column property="article" header="Статья"/>
                            <!-- можно добавить дополнительные колонки -->
                        </columns>
                        <actions>
                            <!-- открывает детальный экран нарушения -->
                            <action id="create" type="list_create"/>
                            <action id="edit" type="list_edit"/>
                            <action id="remove" type="list_remove"/>
                        </actions>
                    </dataGrid>

                    <!-- БЛОК 3. Уголовные нарушения -->
                    <h3 text="Уголовная практика"/>
                    <hbox spacing="true">
                        <button id="addCriminalBtn" action="criminalViolationsDataGrid.create" text="Добавить/Редактировать УП" themeNames="primary"/>
                        <button id="removeCriminalBtn" action="criminalViolationsDataGrid.remove" text="Удалить"/>
                    </hbox>
                    <dataGrid id="criminalViolationsDataGrid"
                              dataContainer="criminalViolationsDc"
                              width="100%"
                              minHeight="8em">
                        <columns>
                            <!-- свойство type – ваш enum TypeOfCriminal -->
                            <column property="type" header="Тип преступления"/>
                        </columns>
                        <actions>
                            <action id="create" type="list_create"/>
                            <action id="edit" type="list_edit"/>
                            <action id="remove" type="list_remove"/>
                        </actions>
                    </dataGrid>
                </vbox>
                <!-- ПРАВАЯ КОЛОНКА - ФОРМА С ДАННЫМИ НАРЯДА -->
                <formLayout id="form" dataContainer="shiftDc" height="100%">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                    </responsiveSteps>
                    <h3>Данные наряда</h3>
                    <select id="numberField" property="number"/>
                    <select id="typeOfShiftField" property="typeOfShift"/>
                    <datePicker id="dateField" property="date"/>
                    <select id="department" property="departmentToday"/>
                    <textField id="countOfStatementsField" property="countOfStatements"/>
                    <textField id="ibdWithMigrantField" property="ibdWithMigrant"/>
                    <textField id="ibdWithoutMigrantField" property="ibdWithoutMigrant"/>
                    <textField id="countOfClaimsField" property="countOfClaims"/>
                    <timePicker id="startTimeField" property="startTime"/>
                    <timePicker id="endTimeField" property="endTime"/>
                </formLayout>
            </hbox>
        </vbox>
        <hbox id="detailActions"
              classNames="px-m py-s bg-contrast-5">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
