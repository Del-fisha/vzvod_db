<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://serviceInfoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="serviceInfoDc"
                  class="com.company.vzvod.entity.ServiceInfo">
            <fetchPlan>
                <property name="idCard" fetchPlan="_instance_name">
                    <property name="issued"/>
                    <property name="until"/>
                </property>
                <property name="rank"/>
                <property name="status"/>
                <property name="post"/>
                <property name="token"/>
                <property name="breastplate"/>
                <property name="startDate"/>
                <property name="startOfPost"/>
                <property name="department"/>
                <property name="shifts"/>
                <property name="incentive"/>
                <property name="penalty"/>
                <property name="medicalExamination"/>
            </fetchPlan>
            <loader id="serviceInfoDl"/>
        </instance>
        <collection id="departmentsDc" class="com.company.vzvod.entity.Department">
            <loader id="departmentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Department e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>


    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>

    <layout>
        <!-- Две колонки: слева форма, справа зависимые списки -->
        <hbox width="100%" spacing="true">

            <!-- Левая колонка: все поля ServiceInfo -->

            <formLayout id="form"
                        dataContainer="serviceInfoDc"
                        labelsPosition="ASIDE">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="40em" columns="2"/>
                </responsiveSteps>

                <entityComboBox id="departmentField"
                                property="department"
                                dataContainer="serviceInfoDc"
                                itemsContainer="departmentsDc"/>

                <select id="rankField" property="rank"/>
                <select id="statusField" property="status"/>
                <select id="postField" property="post"/>

                <textField id="tokenField" property="token"/>
                <textField id="breastplateField" property="breastplate"/>
                <datePicker id="startDateField" property="startDate"/>
                <datePicker id="startOfPostField" property="startOfPost"/>

                <entityPicker id="idCardField"
                              property="idCard"
                              visible="false">
                    <actions>
                        <action id="entityOpen" type="entity_openComposition"/>
                    </actions>
                </entityPicker>
            </formLayout>


            <!-- Правая колонка: кнопки зависимостей -->
<!--            <vbox width="35%" spacing="true">-->
<!--                <h3 text="Связанные сущности"/>-->



<!--            </vbox>-->

        </hbox>

        <hbox width="100%" spacing="true">
            <vbox>
                <button id="idCardCreateButton"
                        text="msg://com.company.vzvod.view.user.user/idCardButtonCreate.text"
                        action="idCardField.entityOpen"/>

                <checkbox id="medicalExamination"
                          dataContainer="serviceInfoDc"
                          property="medicalExamination"
                          label="Профосмотр"
                          helperText=""
                          classNames="align-checkbox"/>

            </vbox>


            <vbox>
                <button id="vocationListButton"
                        text="msg://com.company.vzvod.view.user.user/vocationButtonCreate.text"/>

                <button id="incentiveListButton"
                        text="msg://com.company.vzvod.view.penalty/incentiveListView.title"/>

                <button id="penaltyListButton"
                        text="msg://com.company.vzvod.view.penalty/penaltyListView.title"/>

            </vbox>

        </hbox>


        <button id="shiftListButton"
                text="msg://com.company.vzvod.view.shift/shiftListView.title"
                width="100%"/>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
