<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://eventListView.title"
      focusComponent="eventsDataGrid">
    <data>
        <collection id="eventsDc"
                    class="com.company.vzvod.entity.Event">
            <fetchPlan extends="_base"/>
            <loader id="eventsDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e
                        from Event e
                        where e.date >= CURRENT_DATE
                        order by e.date asc
                        ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox width="100%" spacing="true" alignItems="START">
            <vbox classNames="events-switcher" width="240px" flexShrink="0" spacing="true">
                <button id="eventsPlannedBtn" text="Планируемые" themeNames="primary"/>
                <button id="eventsPastBtn" text="Прошедшие"/>
                <button id="eventsWithoutSquadBtn" text="Без взвода"/>
            </vbox>

            <vbox classNames="events-content" width="100%" flexGrow="1" spacing="true">
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="createButton" action="eventsDataGrid.createAction"/>
                        <button id="editButton" action="eventsDataGrid.editAction"/>
                        <button id="archiveWithoutSquadButton" action="eventsDataGrid.archiveWithoutSquadAction" themeNames="primary"/>
                        <button id="permanentDeleteButton" action="eventsDataGrid.permanentDeleteAction" themeNames="error"/>
                    </startSlot>
                    <endSlot>
                        <simplePagination id="pagination" dataLoader="eventsDl"/>
                    </endSlot>
                </hbox>
                <dataGrid id="eventsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="eventsDc"
                          columnReorderingAllowed="true"
                          selectionMode="MULTI">
                    <actions>
                        <action id="createAction" type="list_create"/>
                        <action id="editAction" type="list_edit"/>
                        <action id="archiveWithoutSquadAction"
                                type="list_itemTracking"
                                text="msg://eventListView.archiveWithoutSquad"
                                themeNames="primary"/>
                        <action id="permanentDeleteAction"
                                type="list_itemTracking"
                                text="msg://eventListView.permanentDelete"
                                themeNames="error"/>
                    </actions>
                    <columns resizable="true">
                        <column property="date"/>
                        <column property="name"/>
                        <column property="eventType"/>
                        <column property="time"/>
                        <column property="place"/>
                        <column property="shiftOfDepartment"/>
                        <column property="description"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectButton" action="selectAction"/>
                    <button id="discardButton" action="discardAction"/>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</view>
