<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://eventListView.title"
      focusComponent="eventsDataGrid">
    <data>
        <collection id="eventsDc"
                    class="com.company.vzvod.entity.Event">
            <fetchPlan extends="_base"/>
            <loader id="eventsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Event e ORDER BY e.date DESC]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="eventsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="eventsDataGrid.createAction"/>
                <button id="editButton" action="eventsDataGrid.editAction"/>
                <button id="removeButton" action="eventsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="eventsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="eventsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="eventsDc"
                  columnReorderingAllowed="true"
                  selectionMode="MULTI">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="eventType"/>
                <column property="name"/>
                <column property="date"/>
                <column property="time"/>
                <column property="place"/>
                <column property="shiftOfDepartment"/>
                <column property="description"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
