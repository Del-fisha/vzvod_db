<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://eventDetailView.title"
      focusComponent="form">
    <data>
        <instance id="eventDc"
                  class="com.company.vzvod.entity.Event">
            <fetchPlan extends="_base"/>
            <loader id="eventDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="eventDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="eventTypeField" property="eventType"/>
            <textField id="nameField" property="name"/>
            <datePicker id="dateField" property="date"/>
            <timePicker id="timeField" property="time"/>
            <textField id="shiftOfDepartmentField" property="shiftOfDepartment"/>
            <textArea id="descriptionField" height="9.5em" property="description"/>
            <textField id="placeField" property="place"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
