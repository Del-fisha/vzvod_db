FROM eclipse-temurin:21-jre

WORKDIR /app

# Expects a jar in build/libs/ (run from core/). Plain bootJar bundles Vaadin *dev* mode and
# the app crashes in Docker (it looks for the host path to src, e.g. D:\...\core).
# Always build production frontend before copying into this image:
#   .\gradlew.bat clean vaadinBuildFrontend bootJar "-Pvaadin.productionMode=true" -x test
COPY build/libs/*.jar ./app.jar

EXPOSE 8080

ENV JAVA_OPTS=""
ENV VAADIN_PRODUCTION_MODE="true"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]

